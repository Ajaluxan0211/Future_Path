generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  USER
  AGENCY
  ADMIN
}

enum VerificationStatus {
  PENDING
  APPROVED
  REJECTED
}

model User {
  id        String   @id @default(cuid())
  name      String
  email     String   @unique
  password  String
  role      UserRole @default(USER)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Existing agency relationship
  agency Agency?

  // Reviews written by this user
  reviews Review[]
}

model Agency {
  id                 String   @id @default(cuid())
  name               String
  ownerName          String
  registrationNumber String?  @unique
  description        String?
  website            String?
  phone              String?
  address            String?
  country            String?
  services           String[] @default([])
  operatingCountries String[] @default([])

  // Uploaded verification documents
  businessRegistrationUrl  String?
  migrationLicenseUrl      String?
  governmentCertificateUrl String?
  officePhotoUrl           String?

  // Admin verification
  verificationStatus VerificationStatus @default(PENDING)
  rejectionReason    String?
  reviewedAt         DateTime?
  reviewedBy         String?

  submittedAt DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Existing user relationship
  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Reviews received by this agency
  reviews Review[]
}

model Review {
  id      String @id @default(cuid())
  rating  Int
  comment String @db.VarChar(2000)

  // The agency being reviewed
  agencyId String
  agency   Agency @relation(fields: [agencyId], references: [id], onDelete: Cascade)

  // The user who wrote the review
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Each user can review each agency only once
  @@unique([agencyId, userId])
  // Makes agency-specific review queries efficient
  @@index([agencyId, createdAt])
}
